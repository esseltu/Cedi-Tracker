@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  body {
    font-family: 'Inter', 'SF Pro Display', system-ui, -apple-system, sans-serif;
    font-feature-settings: "ss01";
    font-weight: 300;
    @apply bg-[#f6f9fc] min-h-screen text-[#0d253d] antialiased;
    @apply dark:bg-[#0b1329] dark:text-[#f6f9fc];
  }

  /* Prevent mobile auto-zoom on inputs */
  @media screen and (max-width: 767px) {
    input, textarea, select {
      font-size: 16px !important;
    }
  }
}

@layer utilities {
  .font-tnum {
    font-feature-settings: "tnum", "ss01";
    letter-spacing: -0.42px;
  }
}

@layer components {
  /* Stripe-inspired Card Components */
  .stripe-card {
    @apply bg-white border border-[#e3e8ee] shadow-[0_1px_3px_rgba(0,55,112,0.08)] rounded-xl;
    @apply dark:bg-[#1c1e54] dark:border-white/10 dark:shadow-[0_8px_24px_rgba(0,0,0,0.3)];
  }

  .stripe-card-interactive {
    @apply bg-white border border-[#e3e8ee] shadow-[0_1px_3px_rgba(0,55,112,0.08)] rounded-xl hover:border-[#533afd]/40 hover:shadow-[0_8px_24px_rgba(0,55,112,0.12)] transition-all cursor-pointer;
    @apply dark:bg-[#1c1e54] dark:border-white/10 dark:hover:border-[#533afd]/60;
  }

  /* Stripe-style Pill Buttons */
  .btn-stripe-primary {
    @apply bg-[#533afd] hover:bg-[#4434d4] active:bg-[#2e2b8c] text-white text-sm font-normal py-2 px-4 rounded-full transition-all shadow-sm flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed;
  }

  .btn-stripe-secondary {
    @apply bg-white border border-[#e3e8ee] hover:bg-[#f6f9fc] hover:border-[#a8c3de] text-[#0d253d] text-sm font-normal py-2 px-4 rounded-full transition-all shadow-sm flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed;
    @apply dark:bg-[#1c1e54] dark:border-white/15 dark:hover:bg-[#273951] dark:text-white;
  }

  .btn-stripe-danger {
    @apply bg-white border border-[#ea2261]/30 hover:bg-[#ea2261]/10 text-[#ea2261] text-sm font-normal py-2 px-4 rounded-full transition-all shadow-sm flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed;
    @apply dark:bg-[#1c1e54] dark:border-[#ea2261]/40 dark:hover:bg-[#ea2261]/20 dark:text-rose-400;
  }

  .btn-stripe-icon {
    @apply w-9 h-9 flex items-center justify-center rounded-full bg-white border border-[#e3e8ee] text-[#273951] hover:bg-[#f6f9fc] hover:text-[#533afd] hover:border-[#a8c3de] transition-all shadow-sm;
    @apply dark:bg-[#1c1e54] dark:border-white/15 dark:text-gray-300 dark:hover:bg-[#273951] dark:hover:text-white;
  }

  .glass-card {
    @apply stripe-card;
  }
}

/* Custom Scrollbar */
::-webkit-scrollbar {
  width: 6px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: #a8c3de;
  border-radius: 10px;
}

.cedi-flip {
  container-type: inline-size;
  width: 100%;
  max-width: 500px;
  aspect-ratio: 1.586 / 1;
  perspective: 1000px;
  color: #fff;
  cursor: pointer;
}
.cedi-flip-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transition: transform 0.8s;
  transform-style: preserve-3d;
}
.cedi-face {
  position: absolute;
  inset: 0;
  border-radius: 1rem;
  background: #171717;
  box-shadow: rgba(0,0,0,.4) 0 2px 2px, rgba(0,0,0,.3) 0 7px 13px -3px, rgba(0,0,0,.2) 0 -1px 0 inset;
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
  overflow: hidden;
}
.cedi-back { transform: rotateY(180deg); }

/* flip: hover on desktop, tap on touch */
@media (hover: hover) {
  .cedi-flip:hover .cedi-flip-inner { transform: rotateY(180deg); }
}
@media (hover: none) {
  .cedi-flip-inner.is-flipped { transform: rotateY(180deg); }
}
@media (prefers-reduced-motion: reduce) {
  .cedi-flip-inner { transition: none; }
}

/* front layout (all sizes scale with card width) */
.cedi-front {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 6cqw;
}
.cedi-row { display: flex; align-items: center; justify-content: space-between; gap: 3cqw; }
.cedi-bottom { align-items: flex-end; }
.cedi-chip {
  width: 11cqw; height: 8.5cqw; border-radius: 1.5cqw;
  background:
    linear-gradient(90deg, transparent 32%, rgba(0,0,0,.25) 33% 35%, transparent 36% 64%, rgba(0,0,0,.25) 65% 67%, transparent 68%),
    linear-gradient(180deg, transparent 45%, rgba(0,0,0,.25) 46% 48%, transparent 49%),
    linear-gradient(135deg, #f5d36b, #c9972b);
}
.cedi-brand { flex: 1; font-size: 3.2cqw; letter-spacing: .2em; }
.cedi-logo { width: 9cqw; height: 9cqw; }
.cedi-number-row { display: flex; align-items: center; gap: 3cqw; }
.cedi-number { font-size: 5.4cqw; font-weight: 700; letter-spacing: .08em; }
.cedi-nfc { width: 5cqw; height: 5cqw; }
.cedi-label { font-size: 2.4cqw; letter-spacing: .12em; opacity: .6; }
.cedi-name { font-size: 3.8cqw; font-weight: 700; text-transform: uppercase; }
.cedi-balance-wrap { text-align: right; }
.cedi-balance { font-size: 7cqw; font-weight: 700; }

/* back */
.cedi-strip {
  position: absolute; top: 9%; left: 0; right: 0; height: 16%;
  background: repeating-linear-gradient(45deg, #303030, #303030 10px, #202020 10px, #202020 20px);
}
.cedi-sign {
  position: absolute; top: 36%; left: 5%; width: 55%; height: 10%;
  background: #fff; border-radius: 2.5px;
}
.cedi-code {
  position: absolute; top: 36%; left: 66%; width: 28%; height: 10%;
  background: #fff; color: #000; border-radius: 2.5px;
  display: flex; align-items: center; justify-content: center;
  font-weight: 700; font-size: 3.5cqw;
}