@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  body {
    font-family: 'Inter', 'SF Pro Display', system-ui, -apple-system, sans-serif;
    font-feature-settings: "ss01";
    font-weight: 300;
    @apply bg-[#f6f9fc] min-h-screen text-[#0d253d] antialiased;
    @apply dark:bg-[#0b1329] dark:text-[#f6f9fc];
  }

  /* Prevent mobile auto-zoom on inputs */
  @media screen and (max-width: 767px) {
    input, textarea, select {
      font-size: 16px !important;
    }
  }
}

@layer utilities {
  .font-tnum {
    font-feature-settings: "tnum", "ss01";
    letter-spacing: -0.42px;
  }
}

@layer components {
  /* Stripe-inspired Card Components */
  .stripe-card {
    @apply bg-white border border-[#e3e8ee] shadow-[0_1px_3px_rgba(0,55,112,0.08)] rounded-xl;
    @apply dark:bg-[#1c1e54] dark:border-white/10 dark:shadow-[0_8px_24px_rgba(0,0,0,0.3)];
  }

  .stripe-card-interactive {
    @apply bg-white border border-[#e3e8ee] shadow-[0_1px_3px_rgba(0,55,112,0.08)] rounded-xl hover:border-[#533afd]/40 hover:shadow-[0_8px_24px_rgba(0,55,112,0.12)] transition-all cursor-pointer;
    @apply dark:bg-[#1c1e54] dark:border-white/10 dark:hover:border-[#533afd]/60;
  }

  /* Stripe-style Pill Buttons */
  .btn-stripe-primary {
    @apply bg-[#533afd] hover:bg-[#4434d4] active:bg-[#2e2b8c] text-white text-sm font-normal py-2 px-4 rounded-full transition-all shadow-sm flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed;
  }

  .btn-stripe-secondary {
    @apply bg-white border border-[#e3e8ee] hover:bg-[#f6f9fc] hover:border-[#a8c3de] text-[#0d253d] text-sm font-normal py-2 px-4 rounded-full transition-all shadow-sm flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed;
    @apply dark:bg-[#1c1e54] dark:border-white/15 dark:hover:bg-[#273951] dark:text-white;
  }

  .btn-stripe-danger {
    @apply bg-white border border-[#ea2261]/30 hover:bg-[#ea2261]/10 text-[#ea2261] text-sm font-normal py-2 px-4 rounded-full transition-all shadow-sm flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed;
    @apply dark:bg-[#1c1e54] dark:border-[#ea2261]/40 dark:hover:bg-[#ea2261]/20 dark:text-rose-400;
  }

  .btn-stripe-icon {
    @apply w-9 h-9 flex items-center justify-center rounded-full bg-white border border-[#e3e8ee] text-[#273951] hover:bg-[#f6f9fc] hover:text-[#533afd] hover:border-[#a8c3de] transition-all shadow-sm;
    @apply dark:bg-[#1c1e54] dark:border-white/15 dark:text-gray-300 dark:hover:bg-[#273951] dark:hover:text-white;
  }

  .glass-card {
    @apply stripe-card;
  }
}

/* Custom Scrollbar */
::-webkit-scrollbar {
  width: 6px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: #a8c3de;
  border-radius: 10px;
}
