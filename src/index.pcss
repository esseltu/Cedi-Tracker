@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  body {
    @apply bg-gradient-to-br from-gray-100 to-gray-200 min-h-screen text-gray-800 font-sans antialiased;
    @apply dark:bg-gradient-to-br dark:from-gray-900 dark:to-gray-950 dark:text-gray-100;
  }
}

@layer components {
  .glass-card {
    @apply bg-white/40 backdrop-blur-md border border-white/50 shadow-lg rounded-2xl;
    @apply dark:bg-white/5 dark:border-white/10;
  }
  
  .glass-button {
    @apply bg-primary/90 hover:bg-primary text-white backdrop-blur-sm shadow-md rounded-xl transition-all active:scale-95;
  }

  .glass-input {
    @apply bg-white/50 border border-white/60 focus:border-primary/50 focus:ring-2 focus:ring-primary/20 rounded-xl px-4 py-3 outline-none transition-all placeholder:text-gray-400;
    @apply dark:bg-gray-800/60 dark:border-gray-700 dark:placeholder:text-gray-400;
  }
}

/* Custom Scrollbar for cleaner look */
::-webkit-scrollbar {
  width: 6px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: rgba(156, 163, 175, 0.5);
  border-radius: 10px;
}
